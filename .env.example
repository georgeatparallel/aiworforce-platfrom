# Copy to .env.local and fill in real values. NEVER commit .env or .env.local.

# ── Server-side only (used by edge functions / server tooling; NO VITE_ prefix) ──
# Firecrawl key — must NOT be bundled to the frontend. Move call sites to an
# edge function before re-enabling Firecrawl-backed features in the UI.
FIRECRAWL_API_KEY=

# Broad web research uses free anonymous Parallel Search MCP when unconfigured.
# Disable it with ENABLE_SEARCH_WEB=false. Keep these server-side.
# Existing SEARCH_WEB_API_KEY/GEMINI_SEARCH settings are never replaced silently.
# Set SEARCH_WEB_PROVIDER=parallel explicitly to choose Parallel over those settings.
# ENABLE_SEARCH_WEB=false
# SEARCH_WEB_PROVIDER=parallel

# ── Frontend (Vite-bundled, anything VITE_* is public in the browser) ──
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# n8n webhooks for lead scraping / advanced search. These URLs are public-ish
# (anyone with the URL can POST), so keep n8n endpoints unguessable.
VITE_N8N_LEAD_SCRAPER_WEBHOOK_URL=
VITE_N8N_ADVANCED_SEARCH_WEBHOOK_URL=

# ── Company Brain onboarding — Apify LinkedIn actors ─────────────────────────
# Set these to actors your Apify account can actually run. A non-existent actor
# id makes every enrichment run 404 (reads as "LinkedIn enrichment not working").
# Defaults point at store-verified vendors; the *_FALLBACK actor is tried when
# the primary returns nothing or sparse data.
APIFY_ACTOR_LINKEDIN_PROFILE_SCRAPER=apimaestro/linkedin-profile-detail
APIFY_ACTOR_LINKEDIN_PROFILE_SCRAPER_FALLBACK=curious_coder/linkedin-profile-scraper
APIFY_ACTOR_LINKEDIN_COMPANY_SCRAPER=curious_coder/linkedin-company-scraper
APIFY_ACTOR_LINKEDIN_COMPANY_SCRAPER_FALLBACK=apimaestro/linkedin-company-detail

# ── THE RAILWAY API (optional; unset = every call goes to Supabase) ──────────
# Where the browser sends the migrated functions. Must name only functions the
# Railway service already serves — see docs/RAILWAY_API_MIGRATION.md.
# VITE_AGENTORY_API_URL=https://your-api.up.railway.app
# VITE_AGENTORY_API_FUNCTIONS=pilot-chat
